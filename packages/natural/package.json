{
  "name": "@toma.com/natural",
  "version": "0.1.0-alpha.3",
  "description": "Desktop-quality 2D and 3D game engine in the class of Unity and Unreal Engine that runs in the browser, built on Bun, WebGPU, and authoritative multiplayer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toma/natural.git",
    "directory": "packages/natural"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "game-engine",
    "webgpu",
    "three.js",
    "bun",
    "typescript"
  ],
  "dependencies": {
    "@toma.com/assets": "workspace:*",
    "@toma.com/core": "workspace:*",
    "@toma.com/gameplay": "workspace:*",
    "@toma.com/netcode": "workspace:*",
    "@toma.com/physics": "workspace:*",
    "@toma.com/plugin-sdk": "workspace:*",
    "@toma.com/render": "workspace:*"
  }
}
