{
  "name": "@natural-engine/cli",
  "version": "0.1.0-alpha.0",
  "description": "Project creation, development, inspection, testing, and export CLI for Natural",
  "type": "module",
  "license": "MIT",
  "bin": {
    "natural": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "game-engine",
    "cli",
    "bun",
    "typescript"
  ],
  "dependencies": {
    "@natural-engine/core": "workspace:*",
    "jsonc-parser": "^3.3.1"
  }
}
