{
  "name": "@toma.com/plugin-sdk",
  "version": "0.1.0-alpha.3",
  "description": "Manifest and extension SDK for Natural engine plugins",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toma/natural.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/toma/natural/tree/main/packages/plugin-sdk#readme",
  "bugs": {
    "url": "https://github.com/toma/natural/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "game-engine",
    "plugins",
    "bun",
    "typescript"
  ],
  "dependencies": {
    "@toma.com/core": "workspace:*"
  }
}
