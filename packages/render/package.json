{
  "name": "@toma.com/render",
  "version": "0.1.0-alpha.3",
  "description": "WebGPU-first 2D and 3D rendering for Natural, powered by Three.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toma/natural.git",
    "directory": "packages/render"
  },
  "sideEffects": false,
