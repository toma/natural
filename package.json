{
  "name": "natural-engine",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toma/natural.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run verify:versions && bun run check:copy && bun run docs:check && bun run format:check && bun run typecheck && bun run lint && bun run test",
    "check:copy": "bun run scripts/check-copy.ts",
    "demo": "bun install --frozen-lockfile && bun run --filter @toma.com/example-urban-raid dev",
    "docs:check": "bun run scripts/generate-docs.ts --check",
    "docs:generate": "bun run scripts/generate-docs.ts",
    "dev": "bun run --filter @toma.com/editor dev",
    "editor": "bun run --filter @toma.com/editor dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test packages examples/urban-raid/tests scripts/tests --coverage && bun run scripts/check-coverage.ts",
    "test:e2e": "bun run scripts/e2e.ts",
    "test:network": "bun run scripts/network-benchmark.ts",
    "pack:check": "bun run build && bun run scripts/package-smoke.ts",
    "verify:versions": "bun run scripts/verify-versions.ts",
    "version:bump": "bun run scripts/bump-version.ts",
    "audit": "bun audit --audit-level=high",
    "release:verify": "bun run verify:versions && bun run check && bun run audit && bun run pack:check && bun run test:e2e && bun run test:network && bun run bench",
    "bench": "bun run scripts/benchmark.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "natural": "bun run packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.35.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
