{
  "name": "natural-engine",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "dev": "bun run --filter @natural-engine/editor dev",
    "editor": "bun run --filter @natural-engine/editor dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test packages --coverage && bun run scripts/check-coverage.ts",
    "test:e2e": "bun run scripts/e2e.ts",
    "test:network": "bun run scripts/network-benchmark.ts",
    "pack:check": "bun run build && bun run scripts/package-smoke.ts",
    "verify:versions": "bun run scripts/verify-versions.ts",
    "audit": "bun audit --audit-level=high",
    "release:verify": "bun run verify:versions && bun run check && bun run audit && bun run pack:check && bun run test:e2e && bun run test:network && bun run bench",
    "bench": "bun run scripts/benchmark.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "natural": "bun run packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.42.0"
  }
}
